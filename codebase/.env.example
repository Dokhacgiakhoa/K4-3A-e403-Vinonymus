# ---------- Supabase (dùng cho app đang chạy) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------- Cron ----------
CRON_SECRET=

# ---------- Ứng dụng ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AIIA Notebook

# ---------- Local Sync & Pipeline (dùng cho scripts/sync-content.ts) ----------
GEMINI_API_KEY=

# ---------- Google Sheet Webhook (Form Khảo sát & Gửi mail xác nhận) ----------
GOOGLE_SHEET_WEBAPP_URL=

# ---------- Backend .NET (tài khoản, duyệt tài khoản, hạn mức khách) ----------
# Bỏ trống: app chưa bắt đăng nhập, hạn mức khách đếm trong bộ nhớ server.
NEXT_PUBLIC_BACKEND_CORE_URL=
# Địa chỉ backend cho lời gọi từ server (mặc định dùng NEXT_PUBLIC_BACKEND_CORE_URL)
BACKEND_CORE_URL=
# Khoá nội bộ cho /api/v1/auth/oauth-sync (≥ 32 ký tự, trùng Backend__InternalApiKey ở backend). Bỏ trống = tắt OAuth.
BACKEND_INTERNAL_API_KEY=
# Chỉ dùng ở máy khi chạy eval: cho gọi /api/roadmap không cần đăng nhập
ALLOW_ANON_AI_MENTOR=

# ---------- Discord Activity Integration (Để trống để tự động chạy Mock Mode) ----------
DISCORD_WEBHOOK_URL=

